#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)

	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заполните поле ""Дата цен""");
		Возврат;
	КонецЕсли;

	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыЗагрузки.Диалог.Заголовок = "Выберите файл для загрузки";
	ПараметрыЗагрузки.Диалог.Фильтр = "Файлы Excel (*.xlsx;*.xls)|*.xlsx;*.xls|Все файлы (*.*)|*.*";

	Оповещение = Новый ОписаниеОповещения(
		"ЗагрузитьИзФайлаЗавершение",
		ЭтотОбъект
	);
	ФайловаяСистемаКлиент.ЗагрузитьФайл(
		Оповещение,
		ПараметрыЗагрузки
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗагрузитьНаСервере(Адрес)

	Ошибки.Очистить();
	Строки = ПрочитатьСтроки(Адрес);

	Записано = 0;

	ЗначенияНоменклатураПоАртикул = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		ЗначенияНоменклатураПоАртикул.Добавить(Строка.Артикул);
	КонецЦикла;
	СсылкиНоменклатураПоАртикул = НайтиНоменклатураПоАртикул(ЗначенияНоменклатураПоАртикул);

	НомерСтроки = 0;
	Для Каждого Строка Из Строки Цикл
		НомерСтроки = НомерСтроки + 1;

		ЗначениеНоменклатура = СсылкиНоменклатураПоАртикул.Получить(Строка.Артикул);
		Если ЗначениеНоменклатура = Неопределено Тогда
			ДобавитьОшибку(
				НомерСтроки,
				Строка.Артикул,
				"Не найдено: Номенклатура.Артикул"
			);
			Продолжить;
		КонецЕсли;

		МенеджерЗаписи = РегистрыСведений.Цены.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = Дата;
		МенеджерЗаписи.Номенклатура = ЗначениеНоменклатура;
		МенеджерЗаписи.Цена = ЧислоИзСтроки(Строка.Цена);

		Попытка
			МенеджерЗаписи.Записать();
		Исключение
			ДобавитьОшибку(
				НомерСтроки,
				"",
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			);
			Продолжить;
		КонецПопытки;

		Записано = Записано + 1;
	КонецЦикла;

	Возврат СтрШаблон(
		"Записано: %1, ошибок: %2",
		Записано,
		Ошибки.Количество()
	);

КонецФункции

&НаСервере
Процедура ДобавитьОшибку(НомерСтроки, Значение, Сообщение)

	СтрокаОшибки = Ошибки.Добавить();
	СтрокаОшибки.НомерСтроки = НомерСтроки;
	СтрокаОшибки.Значение    = Значение;
	СтрокаОшибки.Сообщение   = Сообщение;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьСтроки(Адрес)

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	Строки = Новый Массив;
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ИмяВременногоФайла);

	Для НомерСтроки = 2 По ТабличныйДокумент.ВысотаТаблицы Цикл
		Строка = Новый Структура;
		Область = ТабличныйДокумент.Область("R" + Формат(НомерСтроки, "ЧГ=") + "C1");
		Строка.Вставить("Артикул", СокрЛП(Область.Текст));
		Область = ТабличныйДокумент.Область("R" + Формат(НомерСтроки, "ЧГ=") + "C2");
		Строка.Вставить("Цена", СокрЛП(Область.Текст));
		Если ПустаяСтрока(Строка.Артикул) Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить(Строка);
	КонецЦикла;

	УдалитьФайлы(ИмяВременногоФайла);

	Возврат Строки;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиНоменклатураПоАртикул(Значения)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Таблица.Ссылка КАК Ссылка,
		|	Таблица.Артикул КАК Значение
		|ИЗ
		|	Справочник.Номенклатура КАК Таблица
		|ГДЕ
		|	Таблица.Артикул В (&Значения)
		|	И НЕ Таблица.ПометкаУдаления";
	Запрос.УстановитьПараметр(
		"Значения",
		Значения
	);

	Результат = Новый Соответствие;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(
			Выборка.Значение,
			Выборка.Ссылка
		);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ЧислоИзСтроки(Текст)

	Описание = Новый ОписаниеТипов("Число");
	Возврат Описание.ПривестиЗначение(СтрЗаменить(СтрЗаменить(Текст, " ", ""), ",", "."));

КонецФункции

// Получает адрес файла во временном хранилище и запускает загрузку. Обработчик оповещения
// ФайловаяСистемаКлиент.ЗагрузитьФайл.
//
// Параметры:
//  ПомещенныйФайл - Структура, Неопределено - описание помещенного файла или Неопределено при отказе.
//  ДополнительныеПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура ЗагрузитьИзФайлаЗавершение(ПомещенныйФайл, ДополнительныеПараметры) Экспорт

	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Итог = ЗагрузитьНаСервере(ПомещенныйФайл.Хранение);
	ОбщегоНазначенияКлиент.СообщитьПользователю(Итог);

КонецПроцедуры

#КонецОбласти
