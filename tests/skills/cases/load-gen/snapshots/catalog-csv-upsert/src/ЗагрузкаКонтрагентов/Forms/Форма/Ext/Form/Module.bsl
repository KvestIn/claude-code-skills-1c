#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)

	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыЗагрузки.Диалог.Заголовок = "Выберите файл для загрузки";
	ПараметрыЗагрузки.Диалог.Фильтр = "Файлы CSV (*.csv)|*.csv|Все файлы (*.*)|*.*";

	Оповещение = Новый ОписаниеОповещения(
		"ЗагрузитьИзФайлаЗавершение",
		ЭтотОбъект
	);
	ФайловаяСистемаКлиент.ЗагрузитьФайл(
		Оповещение,
		ПараметрыЗагрузки
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗагрузитьНаСервере(Адрес)

	Ошибки.Очистить();
	Строки = ПрочитатьСтроки(Адрес);

	Создано   = 0;
	Обновлено = 0;
	Пропущено = 0;

	ЗначенияКонтрагентыПоИНН = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		ЗначенияКонтрагентыПоИНН.Добавить(Строка.ИНН);
	КонецЦикла;
	СсылкиКонтрагентыПоИНН = НайтиКонтрагентыПоИНН(ЗначенияКонтрагентыПоИНН);

	НомерСтроки = 0;
	Для Каждого Строка Из Строки Цикл
		НомерСтроки = НомерСтроки + 1;

		Ссылка = СсылкиКонтрагентыПоИНН.Получить(Строка.ИНН);
		Если Ссылка = Неопределено Тогда
			Элемент = Справочники.Контрагенты.СоздатьЭлемент();
		Иначе
			Элемент = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		Элемент.ИНН = Строка.ИНН;
		Элемент.Наименование = Строка.Наименование;
		Элемент.КПП = Строка.КПП;

		Попытка
			Элемент.Записать();
		Исключение
			ДобавитьОшибку(
				НомерСтроки,
				Строка.ИНН,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			);
			Продолжить;
		КонецПопытки;

		Если Ссылка = Неопределено Тогда
			Создано = Создано + 1;
		Иначе
			Обновлено = Обновлено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон(
		"Создано: %1, обновлено: %2, пропущено (уже есть): %3, ошибок: %4",
		Создано,
		Обновлено,
		Пропущено,
		Ошибки.Количество()
	);

КонецФункции

&НаСервере
Процедура ДобавитьОшибку(НомерСтроки, Значение, Сообщение)

	СтрокаОшибки = Ошибки.Добавить();
	СтрокаОшибки.НомерСтроки = НомерСтроки;
	СтрокаОшибки.Значение    = Значение;
	СтрокаОшибки.Сообщение   = Сообщение;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьСтроки(Адрес)

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("csv");
	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	Строки = Новый Массив;
	Чтение = Новый ЧтениеТекста(
		ИмяВременногоФайла,
		КодировкаТекста.UTF8
	);
	Текст = Чтение.ПрочитатьСтроку();
	Текст = Чтение.ПрочитатьСтроку();
	Пока Текст <> Неопределено Цикл
		Если ПустаяСтрока(Текст) Тогда
			Текст = Чтение.ПрочитатьСтроку();
			Продолжить;
		КонецЕсли;

		Части = СтрРазделить(Текст, ";", Истина);
		Пока Части.Количество() < 3 Цикл
			Части.Добавить("");
		КонецЦикла;

		Строка = Новый Структура;
		Строка.Вставить("Наименование", СокрЛП(СтрЗаменить(Части[0], """", "")));
		Строка.Вставить("ИНН", СокрЛП(СтрЗаменить(Части[1], """", "")));
		Строка.Вставить("КПП", СокрЛП(СтрЗаменить(Части[2], """", "")));
		Строки.Добавить(Строка);

		Текст = Чтение.ПрочитатьСтроку();
	КонецЦикла;
	Чтение.Закрыть();

	УдалитьФайлы(ИмяВременногоФайла);

	Возврат Строки;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиКонтрагентыПоИНН(Значения)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Таблица.Ссылка КАК Ссылка,
		|	Таблица.ИНН КАК Значение
		|ИЗ
		|	Справочник.Контрагенты КАК Таблица
		|ГДЕ
		|	Таблица.ИНН В (&Значения)
		|	И НЕ Таблица.ПометкаУдаления";
	Запрос.УстановитьПараметр(
		"Значения",
		Значения
	);

	Результат = Новый Соответствие;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(
			Выборка.Значение,
			Выборка.Ссылка
		);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ЧислоИзСтроки(Текст)

	Описание = Новый ОписаниеТипов("Число");
	Возврат Описание.ПривестиЗначение(СтрЗаменить(СтрЗаменить(Текст, " ", ""), ",", "."));

КонецФункции

// Получает адрес файла во временном хранилище и запускает загрузку. Обработчик оповещения
// ФайловаяСистемаКлиент.ЗагрузитьФайл.
//
// Параметры:
//  ПомещенныйФайл - Структура, Неопределено - описание помещенного файла или Неопределено при отказе.
//  ДополнительныеПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура ЗагрузитьИзФайлаЗавершение(ПомещенныйФайл, ДополнительныеПараметры) Экспорт

	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Итог = ЗагрузитьНаСервере(ПомещенныйФайл.Хранение);
	ОбщегоНазначенияКлиент.СообщитьПользователю(Итог);

КонецПроцедуры

#КонецОбласти
