#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецПериода  = КонецМесяца(ТекущаяДатаСеанса());

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)

	Если НЕ ЗначениеЗаполнено(НачалоПериода) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заполните поле ""Начало периода""");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заполните поле ""Конец периода""");
		Возврат;
	КонецЕсли;

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействие(Команда)

	Если НЕ ЗначениеЗаполнено(НовыйОтветственный) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заполните поле ""Новый ответственный""");
		Возврат;
	КонецЕсли;

	Отмеченные = Список.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если НЕ ЗначениеЗаполнено(Отмеченные) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Отметьте объекты в списке.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения(
		"ВыполнитьЗавершение",
		ЭтотОбъект
	);
	ПоказатьВопрос(
		Оповещение,
		"Изменить отмеченные объекты?",
		РежимДиалогаВопрос.ДаНет
	);

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	УстановитьПометку(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	УстановитьПометку(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Объекты.Ссылка КАК Ссылка,
		|	Объекты.Дата КАК Дата,
		|	Объекты.Номер КАК Номер,
		|	Объекты.Ответственный КАК Ответственный
		|ИЗ
		|	Документ.Заказ КАК Объекты
		|ГДЕ
		|	НЕ Объекты.ПометкаУдаления
		|	И Объекты.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|УПОРЯДОЧИТЬ ПО
		|	Объекты.Дата";
	Запрос.УстановитьПараметр(
		"НачалоПериода",
		НачалоПериода
	);
	Запрос.УстановитьПараметр(
		"КонецПериода",
		КонецДня(КонецПериода)
	);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Список.Очистить();
	Пока Выборка.Следующий() Цикл
		СтрокаСписка = Список.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписка, Выборка);
		СтрокаСписка.Пометка = Истина;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ВыполнитьНаСервере()

	Ошибки.Очистить();
	Обработано = 0;

	Для Каждого СтрокаСписка Из Список Цикл
		Если НЕ СтрокаСписка.Пометка Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ОбъектОбработки = СтрокаСписка.Ссылка.ПолучитьОбъект();
			ОбъектОбработки.Заблокировать();
			ОбъектОбработки.Ответственный = НовыйОтветственный;

			Если ОбъектОбработки.Проведен Тогда
				ОбъектОбработки.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ОбъектОбработки.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			Обработано = Обработано + 1;
		Исключение
			СтрокаОшибки = Ошибки.Добавить();
			СтрокаОшибки.Ссылка    = СтрокаСписка.Ссылка;
			СтрокаОшибки.Сообщение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

			ЗаписьЖурналаРегистрации(
				"СменаОтветственного",
				УровеньЖурналаРегистрации.Ошибка,
				,
				СтрокаСписка.Ссылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
			);
		КонецПопытки;
	КонецЦикла;

	ЗаполнитьНаСервере();

	Возврат СтрШаблон(
		"Обработано: %1, ошибок: %2.",
		Обработано,
		Ошибки.Количество()
	);

КонецФункции

// Выполняет действие над отмеченными объектами после подтверждения пользователя. Обработчик оповещения
// ПоказатьВопрос.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура ВыполнитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Итог = ВыполнитьНаСервере();
	ОбщегоНазначенияКлиент.СообщитьПользователю(Итог);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометку(Пометка)

	Для Каждого СтрокаСписка Из Список Цикл
		СтрокаСписка.Пометка = Пометка;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
