#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Список.Очистить();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)

	Если НЕ ЗначениеЗаполнено(СтаршеДней) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заполните поле ""Старше, дней""");
		Возврат;
	КонецЕсли;

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействие(Команда)

	Если НЕ ЗначениеЗаполнено(Дней) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заполните поле ""Сдвиг, дней""");
		Возврат;
	КонецЕсли;

	Отмеченные = Список.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если НЕ ЗначениеЗаполнено(Отмеченные) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Отметьте объекты в списке.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения(
		"ВыполнитьЗавершение",
		ЭтотОбъект
	);
	ПоказатьВопрос(
		Оповещение,
		"Изменить отмеченные объекты?",
		РежимДиалогаВопрос.ДаНет
	);

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	УстановитьПометку(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	УстановитьПометку(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Объекты.Ссылка КАК Ссылка,
		|	Объекты.Дата КАК Дата,
		|	Объекты.Номер КАК Номер,
		|	Объекты.Статус КАК Статус,
		|	Объекты.ДатаОтгрузки КАК ДатаОтгрузки
		|ИЗ
		|	Документ.Заказ КАК Объекты
		|ГДЕ
		|	НЕ Объекты.ПометкаУдаления
		|	И Объекты.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказов.Закрыт)
		|	И Объекты.Дата < &ГраницаДата
		|УПОРЯДОЧИТЬ ПО
		|	Объекты.Дата";
	Запрос.УстановитьПараметр(
		"ГраницаДата",
		НачалоДня(ТекущаяДатаСеанса()) - СтаршеДней * 86400
	);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Список.Очистить();
	Пока Выборка.Следующий() Цикл
		СтрокаСписка = Список.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписка, Выборка);
		СтрокаСписка.Пометка = Истина;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ВыполнитьНаСервере()

	Ошибки.Очистить();
	Обработано = 0;

	Для Каждого СтрокаСписка Из Список Цикл
		Если НЕ СтрокаСписка.Пометка Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ОбъектОбработки = СтрокаСписка.Ссылка.ПолучитьОбъект();
			ОбъектОбработки.Заблокировать();
			Если ЗначениеЗаполнено(ОбъектОбработки.ДатаОтгрузки) Тогда
				ОбъектОбработки.ДатаОтгрузки = ОбъектОбработки.ДатаОтгрузки + Дней * 86400;
			КонецЕсли;
			Для Каждого СтрокаТЧ Из ОбъектОбработки.Товары Цикл
				Если ЗначениеЗаполнено(СтрокаТЧ.ДатаОтгрузки) Тогда
					СтрокаТЧ.ДатаОтгрузки = СтрокаТЧ.ДатаОтгрузки + Дней * 86400;
				КонецЕсли;
			КонецЦикла;

			Если ОбъектОбработки.Проведен Тогда
				ОбъектОбработки.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ОбъектОбработки.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			Обработано = Обработано + 1;
		Исключение
			СтрокаОшибки = Ошибки.Добавить();
			СтрокаОшибки.Ссылка    = СтрокаСписка.Ссылка;
			СтрокаОшибки.Сообщение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

			ЗаписьЖурналаРегистрации(
				"СдвигОтгрузки",
				УровеньЖурналаРегистрации.Ошибка,
				,
				СтрокаСписка.Ссылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
			);
		КонецПопытки;
	КонецЦикла;

	ЗаполнитьНаСервере();

	Возврат СтрШаблон(
		"Обработано: %1, ошибок: %2.",
		Обработано,
		Ошибки.Количество()
	);

КонецФункции

// Выполняет действие над отмеченными объектами после подтверждения пользователя. Обработчик оповещения
// ПоказатьВопрос.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура ВыполнитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Итог = ВыполнитьНаСервере();
	ОбщегоНазначенияКлиент.СообщитьПользователю(Итог);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометку(Пометка)

	Для Каждого СтрокаСписка Из Список Цикл
		СтрокаСписка.Пометка = Пометка;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
