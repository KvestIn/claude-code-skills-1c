#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Список.Очистить();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействие(Команда)

	Отмеченные = Список.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если НЕ ЗначениеЗаполнено(Отмеченные) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Отметьте объекты в списке.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения(
		"ВыполнитьЗавершение",
		ЭтотОбъект
	);
	ПоказатьВопрос(
		Оповещение,
		"Пометить на удаление отмеченные объекты?",
		РежимДиалогаВопрос.ДаНет
	);

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	УстановитьПометку(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	УстановитьПометку(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Движения.Товар КАК Объект
		|ПОМЕСТИТЬ ВТДвижения
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров КАК Движения
		|ГДЕ
		|	Движения.Период >= &ДатаГраницы
		|ИНДЕКСИРОВАТЬ ПО
		|	Объект
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Объекты.Ссылка КАК Ссылка,
		|	Объекты.Наименование КАК Наименование,
		|	Объекты.Артикул КАК Артикул
		|ИЗ
		|	Справочник.Товары КАК Объекты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДвижения КАК ВТДвижения
		|		ПО Объекты.Ссылка = ВТДвижения.Объект
		|ГДЕ
		|	НЕ Объекты.ПометкаУдаления
		|	И НЕ Объекты.ЭтоГруппа
		|	И ВТДвижения.Объект ЕСТЬ NULL
		|УПОРЯДОЧИТЬ ПО
		|	Объекты.Наименование";
	Запрос.УстановитьПараметр(
		"ДатаГраницы",
		ТекущаяДатаСеанса() - 365 * 86400
	);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Список.Очистить();
	Пока Выборка.Следующий() Цикл
		СтрокаСписка = Список.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписка, Выборка);
		СтрокаСписка.Пометка = Истина;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ВыполнитьНаСервере()

	Ошибки.Очистить();
	Обработано = 0;

	Для Каждого СтрокаСписка Из Список Цикл
		Если НЕ СтрокаСписка.Пометка Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ОбъектОбработки = СтрокаСписка.Ссылка.ПолучитьОбъект();
			ОбъектОбработки.Заблокировать();
			ОбъектОбработки.УстановитьПометкуУдаления(Истина);
			Обработано = Обработано + 1;
		Исключение
			СтрокаОшибки = Ошибки.Добавить();
			СтрокаОшибки.Ссылка    = СтрокаСписка.Ссылка;
			СтрокаОшибки.Сообщение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

			ЗаписьЖурналаРегистрации(
				"ПометкаБезДвижений",
				УровеньЖурналаРегистрации.Ошибка,
				,
				СтрокаСписка.Ссылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
			);
		КонецПопытки;
	КонецЦикла;

	ЗаполнитьНаСервере();

	Возврат СтрШаблон(
		"Обработано: %1, ошибок: %2.",
		Обработано,
		Ошибки.Количество()
	);

КонецФункции

// Выполняет действие над отмеченными объектами после подтверждения пользователя. Обработчик оповещения
// ПоказатьВопрос.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - ответ пользователя.
//  ДополнительныеПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура ВыполнитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Итог = ВыполнитьНаСервере();
	ОбщегоНазначенияКлиент.СообщитьПользователю(Итог);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометку(Пометка)

	Для Каждого СтрокаСписка Из Список Цикл
		СтрокаСписка.Пометка = Пометка;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
