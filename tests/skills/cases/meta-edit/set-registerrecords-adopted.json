{
  "name": "set-registerRecords: документ, заимствованный в расширение (элемента RegisterRecords нет)",
  "setup": "empty-config",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": { "type": "Document", "name": "Расход" },
      "args": { "-JsonPath": "{inputFile}", "-OutputDir": "{workDir}" }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": { "-Name": "Тест", "-OutputDir": "{workDir}/ext", "-ConfigPath": "{workDir}" }
    },
    {
      "script": "cfe-borrow/scripts/cfe-borrow",
      "args": { "-ExtensionPath": "{workDir}/ext", "-ConfigPath": "{workDir}", "-Object": "Document.Расход" }
    }
  ],
  "params": { "objectPath": "ext/Documents/Расход.xml" },
  "input": { "modify": { "properties": { "RegisterRecords": ["AccumulationRegister.Остатки"] } } }
}
