{
  "name": "-Attributes All: все реквизиты и табличные части при заимствовании нового объекта (раньше 'All' считался именем и давал 0 реквизитов)",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Document",
        "name": "ПриходТоваров",
        "attributes": [
          "Склад: String(50)",
          "Комментарий: String(200)"
        ],
        "tabularSections": [
          {
            "name": "Товары",
            "attributes": [
              "Товар: String(100)",
              "Количество: Number(15,3)"
            ]
          }
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "cfe-init/scripts/cfe-init",
      "args": {
        "-Name": "Тест",
        "-OutputDir": "{workDir}/ext",
        "-ConfigPath": "{workDir}"
      }
    }
  ],
  "params": {
    "extensionPath": "ext",
    "object": "Document.ПриходТоваров"
  },
  "args_extra": [
    "-Attributes",
    "All"
  ]
}