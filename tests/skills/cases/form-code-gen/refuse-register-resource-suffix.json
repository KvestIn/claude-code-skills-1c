{
  "name": "Отказ: ресурс виртуальной таблицы остатков без суффикса Остаток",
  "runtimeOnly": "python",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Контрагенты"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Договоры",
        "owners": [
          "Catalog.Контрагенты"
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "AccumulationRegister",
        "name": "Взаиморасчеты",
        "registerType": "Balance",
        "dimensions": [
          "Контрагент: CatalogRef.Контрагенты"
        ],
        "resources": [
          "Сумма: Number(15,2)"
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Document",
        "name": "Реализация",
        "attributes": [
          "Контрагент: CatalogRef.Контрагенты",
          "Договор: CatalogRef.Договоры",
          "СуммаДокумента: Number(15,2)"
        ],
        "tabularSections": [
          {
            "name": "Товары",
            "attributes": [
              "Количество: Number(15,3)",
              "Цена: Number(15,2)",
              "Сумма: Number(15,2)"
            ]
          }
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": {
        "-ObjectPath": "{workDir}/Documents/Реализация.xml",
        "-FormName": "ФормаДокумента"
      }
    },
    {
      "script": "form-compile/scripts/form-compile",
      "input": {
        "events": {
          "OnCreateAtServer": "ПриСозданииНаСервере"
        },
        "attributes": [
          {
            "name": "Объект",
            "type": "DocumentObject.Реализация",
            "main": true
          }
        ],
        "elements": [
          {
            "input": "Контрагент",
            "path": "Объект.Контрагент"
          },
          {
            "input": "Договор",
            "path": "Объект.Договор"
          },
          {
            "input": "СуммаДокумента",
            "path": "Объект.СуммаДокумента"
          }
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputPath": "{workDir}/Documents/Реализация/Forms/ФормаДокумента/Ext/Form.xml"
      }
    }
  ],
  "input": {
    "configPath": ".",
    "extension": {
      "path": "cfe/ICOM_Формы",
      "name": "ICOM_Формы"
    },
    "object": "Document.Реализация",
    "form": "ФормаДокумента",
    "elements": [
      {
        "kind": "label",
        "name": "СуммаПродаж",
        "after": "Контрагент",
        "query": "ВЫБРАТЬ\n\tОстатки.Сумма КАК Значение\nИЗ\n\tРегистрНакопления.Взаиморасчеты.Остатки(, Контрагент = &Контрагент) КАК Остатки",
        "params": {
          "Контрагент": "Объект.Контрагент"
        },
        "template": "Продажи: %1",
        "refreshOn": [
          "Контрагент"
        ]
      }
    ]
  },
  "noSnapshot": "отказ, файлы не создаются",
  "expectError": "СуммаОстаток"
}