{
  "name": "Подключаемая команда в форме списка: свой вид, серверный обработчик с запросом по выбранным",
  "runtimeOnly": "python",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "CommonModule",
        "name": "ПодключаемыеКомандыПереопределяемый",
        "server": true
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "CommonModule",
        "name": "СозданиеНаОснованииПереопределяемый",
        "server": true
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Контрагенты"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Document",
        "name": "Заказ",
        "attributes": [
          "Контрагент: CatalogRef.Контрагенты",
          "СуммаДокумента: Number(15,2)"
        ],
        "tabularSections": [
          {
            "name": "Товары",
            "attributes": [
              "Номенклатура: String(100)",
              "Количество: Number(15,3)"
            ]
          }
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Document",
        "name": "Счет",
        "attributes": [
          "Контрагент: CatalogRef.Контрагенты",
          "Основание: DocumentRef.Заказ"
        ],
        "tabularSections": [
          {
            "name": "Товары",
            "attributes": [
              "Номенклатура: String(100)",
              "Количество: Number(15,3)"
            ]
          }
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "writeFile": {
        "path": "CommonModules/ПодключаемыеКомандыПереопределяемый/Ext/Module.bsl",
        "content": "#Область ПрограммныйИнтерфейс\n\nПроцедура ПриОпределенииВидовПодключаемыхКоманд(ВидыПодключаемыхКоманд) Экспорт\n\n\tВид = ВидыПодключаемыхКоманд.Добавить();\n\tВид.Имя = \"Печать\";\n\nКонецПроцедуры\n\nПроцедура ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды) Экспорт\n\nКонецПроцедуры\n\n#КонецОбласти\n"
      }
    }
  ],
  "input": {
    "configPath": ".",
    "extension": {
      "path": "cfe/ICOM_Команды",
      "name": "ICOM_Команды"
    },
    "commands": [
      {
        "kind": "attached",
        "name": "СуммаВыбранных",
        "title": "Сумма выбранных",
        "objects": [
          "Document.Заказ"
        ],
        "result": {
          "query": "ВЫБРАТЬ\n\tСУММА(Заказы.СуммаДокумента) КАК Значение\nИЗ\n\tДокумент.Заказ КАК Заказы\nГДЕ\n\tЗаказы.Ссылка В (&Ссылки)",
          "template": "Сумма: %1"
        }
      }
    ]
  }
}